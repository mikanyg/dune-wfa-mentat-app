@* Small inline icons drawn in the current text colour and size, so they look the same on every
   device instead of falling back to system symbol fonts (the bundled fonts cover Latin text only). *@
<svg class="icon @Class" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case IconName.Info:
            <circle cx="12" cy="12" r="9.5" />
            <path d="M12 11v6" />
            <circle cx="12" cy="7.5" r="1.2" fill="currentColor" stroke="none" />
            break;
        case IconName.Battle:
            <path d="M5 4l9 9M4 5l1-1M14.5 13.5l2 2M13.5 14.5l-1.5 1.5 3 3 1.5-1.5M16 16l3.5 3.5" />
            <path d="M19 4l-9 9M20 5l-1-1M9.5 13.5l-2 2M10.5 14.5l1.5 1.5-3 3-1.5-1.5M8 16l-3.5 3.5" />
            break;
        case IconName.More:
            <circle cx="5" cy="12" r="1.6" fill="currentColor" stroke="none" />
            <circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none" />
            <circle cx="19" cy="12" r="1.6" fill="currentColor" stroke="none" />
            break;
        case IconName.Sword:
            <path d="M18.5 3.5H20.5V5.5L9 17l-2-2z" />
            <path d="M5 13l6 6M7.5 16.5l-3.5 3.5" />
            break;
        case IconName.Shield:
            <path d="M12 3l7.5 3v5.5c0 4.5-3.2 8-7.5 9.5-4.3-1.5-7.5-5-7.5-9.5V6z" />
            break;
        case IconName.Special:
            <path d="M12 3l2.6 5.6 6 .7-4.5 4.1 1.2 6L12 16.4l-5.3 3 1.2-6-4.5-4.1 6-.7z" />
            break;
    }
</svg>

@code {
    public enum IconName
    {
        Info,
        Battle,
        More,

        // Combat die results.
        Sword,
        Shield,
        Special,
    }

    [Parameter, EditorRequired]
    public IconName Name { get; set; }

    [Parameter]
    public string? Class { get; set; }
}
