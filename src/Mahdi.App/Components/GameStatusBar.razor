@using Mahdi.Engine.Guidance
@using Mahdi.Engine.Model
@inject GameSession Session
@inject NavigationManager Navigation
@implements IDisposable

@if (Session.State is { } state && OnGamePage)
{
    <div class="status-bar" data-testid="status-bar">
        @* The phase label sits in the centre of the header on wider screens; the round stays here.
           Full name on wide screens, short name on tablets and phones, the stepper badge on the smallest. *@
        <span class="status-phase">
            @if (state.Round > 0)
            {
                <span class="status-round" data-testid="round">Round @state.Round</span>
                <span class="status-sep">·</span>
            }
            @{ var label = PhaseLabel.For(state.Phase); }
            <span class="phase-label" data-testid="phase" data-phase="@state.Phase" data-owner="@label.Owner" title="@label.FullTitle">
                <span class="phase-full">
                    @if (label.Number is { } number)
                    {
                        <span class="phase-number">Phase @number:</span>@Space
                    }
                    <span class="phase-name">@label.Name</span>
                    @if (label.Owner != PhaseOwner.Both)
                    {
                        @Space<span class="phase-owner">(@label.Owner)</span>
                    }
                </span>
                <span class="phase-short">@label.ShortTitle</span>
                <span class="phase-badge">@(label.Badge ?? label.ShortName)</span>
            </span>
        </span>
        <span class="supremacy" data-testid="supremacy" data-value="@state.Supremacy"
              aria-label="@($"Harkonnen Supremacy {state.Supremacy} of {Session.Content.Supremacy.Max}")">
            <span class="supremacy-label">Supremacy</span>
            <span class="supremacy-track">
                @for (var i = 1; i <= Session.Content.Supremacy.Max; i++)
                {
                    <span class="seg @(i <= state.Supremacy ? "on" : "")"></span>
                }
            </span>
            <span class="supremacy-value">@state.Supremacy<span class="supremacy-max">/@Session.Content.Supremacy.Max</span></span>
        </span>
    </div>
}

@code {
    private bool OnGamePage => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("game", StringComparison.OrdinalIgnoreCase);

    public static string PhaseName(Phase phase) => PhaseLabel.For(phase).Name;

    /// <summary>Blazor drops whitespace between elements; the label needs real spaces (screen readers, copied text).</summary>
    private const string Space = " ";

    protected override void OnInitialized()
    {
        Session.Changed += OnChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => OnChanged();

    public void Dispose()
    {
        Session.Changed -= OnChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
