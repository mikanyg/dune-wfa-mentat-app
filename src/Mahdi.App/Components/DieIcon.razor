@using Mahdi.Engine.Model

@* Simple original glyphs for the five Harkonnen die results (not copies of the game's icons). *@
<svg class="die-icon @Class" viewBox="0 0 24 24" role="img" aria-label="@Mahdi.Engine.Guidance.GuidanceBuilder.FaceName(Face)">
    @switch (Face)
    {
        case DieFace.Leadership:
            <path d="M3.5 18.5h17v2h-17z" fill="currentColor" />
            <path d="M3.5 16.5V6.5l4.2 4 4.3-6.5 4.3 6.5 4.2-4v10z" fill="currentColor" />
            break;
        case DieFace.Strategy:
            <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M12 2.5v6.5M12 15v6.5M2.5 12H9M15 12h6.5" />
                <path d="M5.8 7.6a7.5 7.5 0 0 1 1.8-1.8M16.4 5.8a7.5 7.5 0 0 1 1.8 1.8M18.2 16.4a7.5 7.5 0 0 1-1.8 1.8M7.6 18.2a7.5 7.5 0 0 1-1.8-1.8" />
            </g>
            <path d="M12 9.6l2.4 2.4-2.4 2.4-2.4-2.4z" fill="currentColor" />
            break;
        case DieFace.Deployment:
            <path d="M6 2.5h12v19l-6-5-6 5z" fill="currentColor" />
            <path d="M12 7.5l2 3-2 3-2-3z" fill="var(--die-bg, #fff)" />
            break;
        case DieFace.Mentat:
            <path d="M12 2.5l9.5 9.5-9.5 9.5L2.5 12z" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linejoin="round" />
            <path d="M12 8.5l3.5 3.5-3.5 3.5L8.5 12z" fill="currentColor" />
            break;
        case DieFace.House:
            <path d="M2.5 13.5c3-5.5 7-8 11.5-8l7.5-3-3 5.2c1 2.4.2 5.4-2.8 7.3L12.5 21.5l-.8-6.2c-3.4.3-6.4-.3-9.2-1.8z" fill="currentColor" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public DieFace Face { get; set; }

    [Parameter]
    public string? Class { get; set; }
}
