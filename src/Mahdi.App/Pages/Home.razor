@page "/"
@inject GameSession Session
@implements IDisposable

<PageTitle>Harkonnen Mentat</PageTitle>

<div class="page-centered">
    <section class="hero">
        <h1>Harkonnen Mentat</h1>
        <p class="subtitle">Companion app for Dune: War for Arrakis' Mahdi Solo mode</p>
        <p class="quote">The Harkonnens will not rest. Let the app move them, so your eyes stay on the sand.</p>
        <div class="ornament"><span>◆</span></div>
        <div class="stack home-actions">
            @if (!Session.IsLoaded)
            {
                <p class="muted">Unrolling the maps…</p>
            }
            else if (Session.State is { Phase: not Mahdi.Engine.Model.Phase.GameOver } state)
            {
                <a class="btn btn-primary btn-big" href="game" data-testid="continue-game">
                    Continue: Round @(Math.Max(1, state.Round)) · @GameStatusBar.PhaseName(state.Phase)
                </a>
                <a class="btn btn-big" href="new" data-testid="new-game">New game</a>
            }
            else
            {
                <a class="btn btn-primary btn-big" href="new" data-testid="new-game">New game</a>
            }
            <a class="btn btn-ghost" href="reference" data-testid="reference-link">Solo rules quick reference</a>
        </div>
    </section>
</div>

@code {
    protected override void OnInitialized() => Session.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= OnChanged;
}
