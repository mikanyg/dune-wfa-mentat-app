@page "/game"
@using Mahdi.Engine.Commands
@using Mahdi.Engine.Guidance
@using Mahdi.Engine.Model
@inject GameSession Session
@inject HelpService Help
@implements IDisposable

<PageTitle>@Title · Harkonnen Mentat</PageTitle>

@if (!Session.IsLoaded)
{
    <div class="page-centered"><p class="muted">Unrolling the maps…</p></div>
}
else if (Session.State is not { } state)
{
    <div class="page-centered">
        <section class="hero">
            <h2>No game in progress</h2>
            <a class="btn btn-primary" href="new">Start a new game</a>
        </section>
    </div>
}
else
{
    <div class="game-layout">
        <StateRail State="state" />
        <section class="stage" data-testid="stage">
            <NoticeList State="state" />
            @if (state.Phase is not (Phase.Setup or Phase.GameOver))
            {
                <nav class="quick-actions" aria-label="Game events">
                    @if (state.Phase == Phase.ActionResolution || state.Battle is not null)
                    {
                        <button type="button" class="btn btn-small" data-testid="open-battle" @onclick='() => OpenSheet("battle")'><Icon Name="Icon.IconName.Battle" />Battle</button>
                    }
                    <button type="button" class="btn btn-small" data-testid="open-sietch" @onclick='() => OpenSheet("sietch")'>Sietch destroyed</button>
                    <button type="button" class="btn btn-small" data-testid="open-events" @onclick='() => OpenSheet("menu")'><Icon Name="Icon.IconName.More" />More events</button>
                    <button type="button" class="btn btn-small" data-testid="open-combat-power" @onclick="() => Help.Show(HelpTopic.CombatPower)"><Icon Name="Icon.IconName.Info" />Combat Power</button>
                </nav>
            }
            @if (state.Battle is { } battle && sheet != "battle")
            {
                <button type="button" class="battle-bar" data-testid="battle-bar" @onclick='() => OpenSheet("battle")'>
                    <Icon Name="Icon.IconName.Battle" />
                    <span class="battle-bar-text">Battle · round @battle.Round · @BattleGuidance.Headline(Session.Content, battle) · @state.Reinforcements Reinforcements</span>
                    <span class="battle-bar-open">Open ▶</span>
                </button>
            }
            @switch (state.Phase)
            {
                case Phase.Setup:
                    <GuidanceCard Guidance="GuidanceBuilder.Setup()" Class="frame" NotesOpen="true" TestId="setup-guidance" />
                    <button type="button" class="btn btn-primary btn-big" data-testid="confirm-phase"
                            @onclick="() => Session.Execute(new CompleteSetup())">Setup done: start round 1 ▶</button>
                    break;

                case Phase.RoundStart:
                    <TacticalCards State="state" />
                    <GuidanceCard Guidance="Session.Guidance.RoundStart(state)" Class="frame" ShowTitle="false" TestId="round-guidance" />
                    <button type="button" class="btn btn-primary btn-big" data-testid="confirm-phase"
                            @onclick="() => Session.Execute(new ConfirmRoundStart())">Continue to Vehicle Placement ▶</button>
                    break;

                case Phase.VehiclePlacement:
                    <GuidanceCard Guidance="Session.Guidance.VehiclePlacement(state)" Class="frame" TestId="vehicle-guidance" />
                    <button type="button" class="btn btn-primary btn-big" data-testid="confirm-phase"
                            @onclick="() => Session.Execute(new ConfirmVehicles())">Vehicles placed: begin actions ▶</button>
                    break;

                case Phase.ActionResolution:
                    <WarTable State="state" />
                    break;

                case Phase.DesertHazards:
                    <GuidanceCard Guidance="GuidanceBuilder.DesertHazards()" Class="frame" TestId="hazards-guidance" />
                    <button type="button" class="btn btn-primary btn-big" data-testid="confirm-phase"
                            @onclick="() => Session.Execute(new ConfirmDesertHazards())">Hazards resolved: harvest spice ▶</button>
                    break;

                case Phase.SpiceHarvesting:
                    <SpicePanel State="state" />
                    break;

                case Phase.EndOfRound:
                    @if (state.LastSpiceResult is { } spice)
                    {
                        <GuidanceCard Guidance="GuidanceBuilder.SpiceResult(spice)" Class="frame" TestId="spice-result" />
                    }
                    <GuidanceCard Guidance="Session.Guidance.EndOfRound(state)" Class="frame" TestId="end-guidance" />
                    <div class="button-row">
                        <button type="button" class="btn btn-primary btn-big" data-testid="confirm-phase"
                                @onclick="() => Session.Execute(new EndRound())">End round @state.Round ▶</button>
                        <button type="button" class="btn btn-big atreides-btn" data-testid="atreides-victory"
                                @onclick="() => Session.Execute(new DeclareAtreidesVictory())">Atreides objective met</button>
                    </div>
                    break;

                case Phase.GameOver:
                    <GameOverPanel State="state" />
                    break;
            }
        </section>
    </div>

    @if (sheet == "battle")
    {
        <BattleSheet State="state" OnClose="() => sheet = null" />
    }
    else if (sheet is not null)
    {
        <EventSheet State="state" StartView="@sheet" OnClose="() => sheet = null" OnOpenBattle='() => sheet = "battle"' />
    }
}

@code {
    private string? sheet;

    private void OpenSheet(string view) => sheet = view;

    private string Title => Session.State is { } s ? GameStatusBar.PhaseName(s.Phase) : "Game";

    protected override void OnInitialized() => Session.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= OnChanged;
}
